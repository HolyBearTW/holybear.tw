  "scripts": {
    "predev": "npm run generate:rss",
    "dev": "vitepress dev",
    "prebuild": "npm run generate:rss && node scripts/check-react-versions.mjs",
    "build": "vitepress build && node scripts/style-sitemap.mjs",
    "generate:rss": "node scripts/generate-rss.mjs",
    "optimize:deploy-images": "node scripts/optimize-deploy-images.mjs",
    "check:maple-calculator": "node scripts/check-maple-calculator.mjs",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:maple-db": "vitest run tests/maple-db",
    "d1:migrate:local": "wrangler d1 migrations apply holybear-maple-db --local",
    "d1:survey:migrate:local": "wrangler d1 migrations apply holybear-survey-db --local",
    "d1:survey:migrate:production": "wrangler d1 migrations apply holybear-survey-db --remote --env production",
    "import:maple": "node scripts/run-maple-import.mjs",
    "import:maple:bg": "node scripts/start-manual-seed-background.mjs",
    "import:maple:status": "node scripts/run-maple-import.mjs manual --dir data/manual-character-seed --status",
    "import:maple:stop": "node scripts/stop-manual-seed-background.mjs",
    "benchmark:nexon-resolver": "node scripts/benchmark-nexon-resolver.mjs",
    "estimate:guilds:full": "node scripts/run-full-guild-estimate.mjs",
    "estimate:guilds:full:status": "node scripts/full-guild-estimate-status.mjs",
    "consumer:failover:status": "node scripts/consumer-failover-status.mjs",
    "watch:maple-background": "node scripts/watch-maple-background-jobs.mjs",
    "preview": "vitepress preview"
  }
