  "overrides": {
    "preact": "10.27.3",
    "front-matter": {
      "js-yaml": "3.14.2"
    },
    "gray-matter": {
      "js-yaml": "3.14.2"
    }
  },
  "resolutions": {
    "@esotericsoftware/spine-core": "4.1.24",
    "@esotericsoftware/spine-webgl": "4.1.24"
